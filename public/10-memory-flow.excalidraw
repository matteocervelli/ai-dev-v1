    {
      "id": "recall-flow",
      "type": "text",
      "x": 480.01171875,
      "y": 155.55859375,
      "width": 258.984375,
      "height": 170,
      "angle": 0,
      "strokeColor": "#1B2631",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "text": "/memory recall \"authentication\"\n\n  1. SQLite FTS5 (locale, ms)\n         ↓\n  2. Thesaurus semantic search\n     (vettoriale, cross-repo)\n         ↓\n  3. Atrium structured queries\n     (dati strutturati, API)\n\n→ Ritorna: file Markdown rilevanti\n   iniettati nel contesto corrente",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 5,
