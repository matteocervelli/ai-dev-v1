    {
      "id": "col3-content",
      "type": "text",
      "x": 765,
      "y": 196,
      "width": 150.1498260498047,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1B2631",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "text": "Cosa:\nstesso context window\nper tutta la sessione\nnessun /compact\n\nCosto:\nalto inizialmente\n(cache hit → economica\npoi aumenta col tempo)\n\nContinuità:\nperfetta\n(nessuna perdita,\nnessun riepiloga)\n\nQuando:\ntask complesso\nin una sola sessione",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "version": 3,
      "versionNonce": 2008931482,
      "index": "aK",
      "isDeleted": false,
      "strokeStyle": "solid",
      "seed": 1,
      "frameId": null,
      "roundness": null,
      "boundElements": [],
