      "fontSize": 14,
      "fontFamily": 3,
      "text": "TASK=\"controlla issue e apri PR\"\nN=10\n\nfor i in $(seq 1 $N); do\n  echo \"--- Iterazione $i/$N ---\"\n  claude -p \"$TASK\"\n  sleep 2\ndone",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TASK=\"controlla issue e apri PR\"\nN=10\n\nfor i in $(seq 1 $N); do\n  echo \"--- Iterazione $i/$N ---\"\n  claude -p \"$TASK\"\n  sleep 2\ndone"
